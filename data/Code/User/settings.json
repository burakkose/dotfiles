{
    "files.watcherExclude": {
        // Version Control
        "**/.git": true,
        // Build Outputs
        "**/build/**": true,
        "**/dist/**": true,
        "**/out/**": true,
        "**/bin/**": true,
        "**/obj/**": true,
        "**/target/**": true,
        "**/.output/**": true,
        // Dependencies
        "**/node_modules/**": true,
        "**/third_party/**": true,
        // Caches
        "**/.cache/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        // IDE/Editor
        "**/.vscode/**": true,
        "**/.idea/**": true,
        "**/.vs/**": true,
        "**/*.code-workspace": true,
        // Temporary Files
        "**/*.log": true,
        "**/*.tmp": true,
        "**/*.temp": true,
        "**/*.swp": true,
        "**/*.swo": true,
        "**/*~": true,
        // OS Files
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/desktop.ini": true,
        // Python
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.egg-info/**": true,
        "**/.eggs/**": true,
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/ENV/**": true,
        "**/env/**": true,
        // Misc
        "**/tmp/**": true,
        "**/temp/**": true,
        "**/.terraform/**": true,
        "**/public/assets/**": true,

        "**/*.o": true,
        "**/*.obj": true,
        "**/*.exe": true,
        "**/*.out": true,
        "**/*.a": true,
        "**/*.so": true,
        "**/*.dll": true,
        "**/*.dylib": true,
        "**/.ccls-cache": true,
        "**/compile_commands.json": false
    },
    "workbench.colorCustomizations": {
        "[Catppuccin Mocha]": {
            "editor.background": "#15151f",
            "editor.foreground": "#bac2de",
            "editorGutter.background": "#15151f",
            "editorStickyScroll.background": "#15151f",
            "editorStickyScrollHover.background": "#15151f",
            "minimap.background": "#15151f",
            "breadcrumb.background": "#15151f",
            "panel.background": "#15151f",
            "terminal.background": "#15151f",
            "sideBar.background": "#0d0d15",
            "sideBarSectionHeader.background": "#0d0d15",
            "activityBar.background": "#0d0d15",
            "statusBar.background": "#0d0d15",
            "titleBar.activeBackground": "#0d0d15",
            "titleBar.inactiveBackground": "#0d0d15",
            "editorGroupHeader.tabsBackground": "#0d0d15",
            "editorGroupHeader.noTabsBackground": "#0d0d15",
            "tab.activeBackground": "#15151f",
            "tab.inactiveBackground": "#0d0d15",
            "tab.hoverBackground": "#15151f",
            "tab.activeBorderTop": "#f9e2af"
        }
    },
    "editor.tokenColorCustomizations": {
        "[Catppuccin Mocha]": {
            "textMateRules": [
                {
                    "name": "Functions — yellow: low per-line density (verbs) so high-arousal yellow works as eye anchor without overwhelming",
                    "scope": [
                        "entity.name.function",
                        "meta.function-call entity.name.function",
                        "support.function"
                    ],
                    "settings": { "foreground": "#f9e2af" }
                },
                {
                    "name": "Types, classes, interfaces, enums — teal: vivid cyan-green hue (Ayu-style), survives gammastep, perceptually calmer than yellow for high-frequency C++ types",
                    "scope": [
                        "entity.name.type",
                        "entity.name.class",
                        "entity.other.inherited-class",
                        "support.class",
                        "support.type",
                        "storage.type"
                    ],
                    "settings": { "foreground": "#94e2d5", "fontStyle": "" }
                },
                {
                    "name": "Function parameters — peach, distinct from regular variables (which stay text)",
                    "scope": [
                        "variable.parameter",
                        "meta.function.parameters variable"
                    ],
                    "settings": { "foreground": "#fab387", "fontStyle": "" }
                },
                {
                    "name": "Storage modifiers (public, static, async, const, let, var) — red, distinct from control keywords",
                    "scope": [
                        "storage.modifier"
                    ],
                    "settings": { "foreground": "#f38ba8" }
                },
                {
                    "name": "Punctuation — dimmer (overlay1) so structure recedes harder against the darker chrome",
                    "scope": [
                        "punctuation",
                        "punctuation.separator",
                        "punctuation.terminator",
                        "meta.brace"
                    ],
                    "settings": { "foreground": "#7f849c" }
                },
                {
                    "name": "Comments — overlay0: deeply faint so they almost vanish, leaving only meaningful code visible",
                    "scope": "comment",
                    "settings": { "foreground": "#6c7086", "fontStyle": "italic" }
                }
            ]
        }
    },
    "editor.semanticTokenColorCustomizations": {
        "[Catppuccin Mocha]": {
            "enabled": true,
            "rules": {
                "function": "#f9e2af",
                "method": "#f9e2af",
                "variable": "#bac2de",
                "property": "#bac2de",
                "parameter": { "foreground": "#fab387", "italic": false },
                "type": { "foreground": "#94e2d5", "italic": false },
                "class": { "foreground": "#94e2d5", "italic": false },
                "interface": { "foreground": "#94e2d5", "italic": false },
                "enum": { "foreground": "#94e2d5", "italic": false },
                "enumMember": "#fab387",
                "struct": { "foreground": "#94e2d5", "italic": false },
                "typeParameter": { "foreground": "#94e2d5", "italic": false },
                "namespace": "#94e2d5",
                "*.constant": "#fab387",
                "*.readonly": "#fab387"
            }
        }
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/.vs": true,
        "**/.vscode": true,
        "**/out": true,
        "**/dist": true,
        "**/bin": true,
        "**/obj": true
    },
    "breadcrumbs.enabled": true,
    "C_Cpp.autocomplete": "default",
    "C_Cpp.autocompleteAddParentheses": true,
    "C_Cpp.clang_format_sortIncludes": true,
    "C_Cpp.default.browse.limitSymbolsToIncludedHeaders": true,
    "C_Cpp.dimInactiveRegions": true,
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseCachePath": "${workspaceFolder}/.vscode/ipch",
    "C_Cpp.intelliSenseCacheSize": 32768,
    "C_Cpp.intelliSenseMemoryLimit": 16384,
    "C_Cpp.loggingLevel": "Error",
    "C_Cpp.workspaceParsingPriority": "highest",
    "debug.inlineValues": "on",
    "debug.console.fontSize": 14,
    "debug.showBreakpointsInOverviewRuler": true,
    "debug.toolBarLocation": "docked",
    "editor.autoClosingBrackets": "always",
    "editor.autoClosingQuotes": "always",
    "editor.autoIndent": "full",
    "editor.autoSurround": "languageDefined",
    "editor.bracketPairColorization.enabled": true,
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "block",
    "editor.foldingStrategy": "auto",
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontLigatures": false, // no thanks :)
    "editor.fontSize": 12,
    "editor.formatOnPaste": true,
    "editor.guides.bracketPairs": true,
    "editor.guides.indentation": true,
    "editor.inlineSuggest.enabled": true,
    "editor.minimap.enabled": false,
    "editor.renderControlCharacters": true,
    "editor.renderWhitespace": "boundary",
    "editor.stickyScroll.enabled": true,
    "editor.rulers": [
        100
    ],
    "editor.smoothScrolling": true,
    "editor.tabCompletion": "on",
    "editor.tabSize": 4,
    "editor.wordWrap": "on",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "git.enableStatusBarSync": true,
    "git.openRepositoryInParentFolders": "always",
    "git.showInlineOpenFileAction": true,
    "local-history.path": "${workspaceFolder}/.vscode/history",
    "redhat.telemetry.enabled": false,
    "search.showLineNumbers": true,
    "security.workspace.trust.enabled": false,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.cursorStyle": "block",
    "terminal.integrated.enablePersistentSessions": true,
    "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.scrollback": 100000,
    "window.customTitleBarVisibility": "windowed",
    "window.menuBarVisibility": "compact",
    "window.zoomLevel": 1,
    "workbench.colorTheme": "Catppuccin Mocha",
    "workbench.editor.enablePreview": false,
    "workbench.editor.highlightModifiedTabs": true,
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "catppuccin.accentColor": "lavender",
    "catppuccin.workbenchMode": "flat",
    "catppuccin.bracketMode": "dimmed",
    "catppuccin.italicComments": true,
    "catppuccin.italicKeywords": false,
    "catppuccin.boldKeywords": true,
}
