{
    "height": 24,
    "modules-left": [
        "sway/workspaces"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "custom/gpu-temp",
        "custom/gpu-usage",
        "custom/gpu-vram",
        "disk#home",
        "disk",
        "network",
        "battery",
        "battery#bat2",
        "backlight",
        "pulseaudio",
        "tray",
        "custom/vpn-name",
        "bluetooth",
        "custom/sunset",
        "custom/notification",
        "clock"
    ],
    "tray": {
        // "icon-size": 21,
        "spacing": 10
    },
    "custom/sunset": {
        "interval": "once",
        "tooltip": true,
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "off": "",
            "on": ""
        },
        "exec": "~/.bin/sunset",
        "on-click": "~/.bin/sunset toggle && /usr/bin/pkill -RTMIN+11 waybar",
        "exec-if": "~/.bin/sunset check",
        "exec-on-event": true,
        "signal": 11
    },
    "custom/gpu-temp": {
        "exec": "sensors | grep -A 5 'amdgpu-pci-0300' | grep 'edge' | awk '{print $2}' | sed 's/+//; s/°C//'",
        "format": "GPU: {}°C",
        "return-type": "",
        "interval": 4
    },
    "custom/gpu-usage": {
        "exec": "echo '{\"text\": \"GPU: '$(cat /sys/class/drm/card1/device/gpu_busy_percent)'%\", \"tooltip\": \"GPU Usage: '$(cat /sys/class/drm/card1/device/gpu_busy_percent)'%\\nMem Controller: '$(cat /sys/class/drm/card1/device/mem_busy_percent)'%\"}'",
        "return-type": "json",
        "format": "{}  ",
        "interval": 2
    },
    "custom/gpu-vram": {
        "exec": "used=$(cat /sys/class/drm/card1/device/mem_info_vram_used); total=$(cat /sys/class/drm/card1/device/mem_info_vram_total); echo '{\"text\": \"'$(awk -v u=$used 'BEGIN {printf \"VRAM: %.1f\", u/1024/1024/1024}')'GiB\", \"tooltip\": \"VRAM: '$(awk -v u=$used 'BEGIN {printf \"%.1f\", u/1024/1024/1024}')' / '$(awk -v t=$total 'BEGIN {printf \"%.1f\", t/1024/1024/1024}')' GB\"}'",
        "return-type": "json",
        "format": "{}  ",
        "interval": 5
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "on-click": "nm-connection-editor"
    },
    "bluetooth": {
        // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-no-controller": "",
        "format-connected": " {num_connections}",
        "format-connected-battery": " {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}  {controller_address}",
        "tooltip-format-connected": "{controller_alias}  {controller_address}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_address}  {device_battery_percentage}%",
        "on-click": "foot bluetoothctl"
    },
    "clock": {
        "format": "{:%A %d.%m.%Y - %H:%M}",
        "tooltip-format": "<span color='#cdd6f4' size='larger'>{:%Y %B}</span>\n<tt>{calendar}</tt>",
        "calendar-weeks-pos": "right",
        "today-format": "<span color='#f38ba8' weight='ultrabold'>{}</span>",
        "format-calendar": "<span color='#cdd6f4' weight='normal'>{}</span>",
        "format-calendar-weeks": "<span color='#89b4fa'><b>W{:%V}</b></span>",
        "format-calendar-weekdays": "<span color='#a6e3a1'><b>{}</b></span>",
        "on-scroll": {
            "calendar": 1
        },
        "on-click": "exec gsimplecal"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "disk": {
        "interval": 30,
        "format": "{free} ",
        "path": "/"
    },
    "disk#home": {
        "interval": 30,
        "format": "{free} ",
        "path": "/home"
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "interval": 5,
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "format": "CPU: {temperatureC}°C"
    },
    "backlight": {
        "format": "{percent}% "
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "battery#bat2": {
        "bat": "BAT1",
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "custom/vpn-name": {
        "exec": "~/.bin/vpn-name",
        "return-type": "json",
        "interval": 5,
        "format": "{text}",
        "tooltip": true
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "  <span foreground='red'><sup>•</sup></span>",
            "none": " ",
            "dnd-notification": "  <span foreground='red'><sup>•</sup></span>",
            "dnd-none": " ",
            "inhibited-notification": "  <span foreground='red'><sup>•</sup></span>",
            "inhibited-none": " ",
            "dnd-inhibited-notification": "  <span foreground='red'><sup>•</sup></span>",
            "dnd-inhibited-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
