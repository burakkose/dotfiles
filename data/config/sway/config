include /etc/sway/config.d/*

# Per-machine output configuration (generated by ~/.bin/sway-detect-outputs
# on first provisioning; safe to hand-edit, see the file for details).
include ~/.config/sway/outputs.local

# Set mod key to Mod1 (Alt)
set $mod Mod1

# Disable focus follows mouse
focus_follows_mouse no

# Sway does not support per-app popup layering above fullscreen windows.
# This is the only reliable setting for rofi/wofi to remain visible.
popup_during_fullscreen smart

# Keep launcher popups floating and borderless as a fallback, but fullscreen stacking is still controlled globally.
for_window [app_id="^wofi$"] floating enable
for_window [app_id="^wofi$"] border none
for_window [app_id="^rofi$"] floating enable
for_window [app_id="^rofi$"] border none

# Set font for window titles and the bar
font pango:monospace 8

# Use Mod1 + Mouse to drag floating windows
floating_modifier $mod

# Wofi keybindings
bindsym $mod+b exec ~/.bin/wofi-bookmarks

# Wofi run application
bindsym $mod+r exec "~/.bin/sway-nofullscreen-launcher wofi --show=run"

# Wofi window switcher
bindsym $mod+w exec "bash ~/.bin/wofi-window-selector"

# Wofi for power management
bindsym $mod+m exec "~/.bin/sway-nofullscreen-launcher ~/.bin/wofi-power-menu"

# Wofi network manager
bindsym $mod+o exec ~/.bin/wofi-connectivity all

# Lock screen using swaylock
bindsym Mod4+l exec "~/.bin/sway-lock"

# Open file manager
bindsym $mod+t exec nautilus

# Set window borders
for_window [app_id="^.*"] border pixel 2

# Navigate through workspaces
bindsym $mod+Ctrl+Left workspace prev
bindsym $mod+Ctrl+Right workspace next

# Output configuration is generated per-machine by
# ~/.bin/sway-detect-outputs and included near the top of this file via
# ~/.config/sway/outputs.local.

# Launch Waybar
bar {
  swaybar_command waybar
}
# exec_always --no-startup-id ~/.bin/waybar-relaunch

# Launch NetworkManager applet (X11 tray under XWayland; consider Wayland alternatives)
exec_always sh -c 'pkill -x nm-applet 2>/dev/null; nm-applet &'

## Sway autostart additions
# Auto-mount + tray icon for removable USB drives
exec_always sh -c 'pkill -x udiskie 2>/dev/null; udiskie --tray --notify --automount &'

# Notification daemon + control center
# exec_always so sway reloads always bring it back; pkill guard avoids duplicates.
exec_always sh -c 'pkill -x swaync 2>/dev/null; swaync &'

# Toggle the notification / control center panel
bindsym Mod4+n exec swaync-client -t -sw
# Dismiss all visible notifications
bindsym Mod4+Shift+n exec swaync-client -d -sw

# Clipboard history (cliphist + wl-clipboard watchers)
# Use a dedicated helper to restart the watchers reliably on Sway reloads.
exec_always ~/.bin/sway-clipboard-history

# Show clipboard history picker
bindsym $mod+p exec ~/.bin/wofi-clipboard
# Wipe clipboard history
bindsym Mod4+Shift+v exec cliphist wipe

# Screenshot pipeline (grim/slurp -> satty for annotation -> wl-copy + save)
bindsym Print exec ~/.bin/screenshot region
bindsym Shift+Print exec ~/.bin/screenshot full
bindsym $mod+Print exec ~/.bin/screenshot window

# Media keys: volume & brightness with swaync OSD
bindsym --locked XF86AudioRaiseVolume  exec ~/.bin/volume-osd up
bindsym --locked XF86AudioLowerVolume  exec ~/.bin/volume-osd down
bindsym --locked XF86AudioMute         exec ~/.bin/volume-osd mute
bindsym --locked XF86AudioMicMute      exec ~/.bin/volume-osd mic-mute
bindsym --locked XF86MonBrightnessUp   exec ~/.bin/brightness-osd up
bindsym --locked XF86MonBrightnessDown exec ~/.bin/brightness-osd down

# Media playback (works for Spotify, mpv, browser, etc. via MPRIS)
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioPrev  exec playerctl previous

# Let Sway manage the wallpaper directly instead of spawning swaybg on reload
output * bg "$HOME/.config/wallpaper/wallpaper.png" fill

# PipeWire already provides the PulseAudio compatibility layer

# Assign applications to workspaces
assign [class="firefox"] workspace 2:Internet
assign [app_id="firefox"] workspace 2:Internet
assign [class="spotify"] workspace 1:Main
assign [instance="spotify"] workspace 1:Main
assign [app_id="spotify"] workspace 1:Main
assign [instance="code"] workspace 3:Code
assign [class="Code"] workspace 3:Code
assign [app_id="code"] workspace 3:Code
assign [app_id="libreoffice"] workspace 4:Doc

### COLORS — Catppuccin Mocha
# Format: client.<state> <border> <bg> <text> <indicator> <child_border>
# Only the border / child_border are visible at `border pixel 2`; bg /
# text / indicator are kept consistent for the rare titled mode.
#
#                       border    bg        text      indicator child_border
client.focused          #f9e2af   #1e1e2e   #11111b   #f9e2af   #f9e2af
client.focused_inactive #45475a   #181825   #cdd6f4   #45475a   #45475a
client.unfocused        #181825   #181825   #7f849c   #181825   #181825
client.urgent           #f38ba8   #f38ba8   #11111b   #f38ba8   #f38ba8
client.placeholder      #11111b   #11111b   #cdd6f4   #11111b   #11111b
client.background       #11111b

# Start a terminal using Foot
bindsym $mod+Ctrl+t exec foot -e /bin/zsh

# Kill focused window
bindsym $mod+Shift+q kill

# Change focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split orientation
bindsym $mod+h split h
bindsym $mod+v split v

# Toggle fullscreen
bindsym $mod+f fullscreen toggle

# Change container layout
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+w layout tabbed
bindsym $mod+Shift+e layout toggle split
bindsym $mod+Shift+h layout splith
bindsym $mod+Shift+v layout splitv

# Toggle floating mode
bindsym $mod+Shift+space floating toggle

# Focus mode toggle
bindsym $mod+space focus mode_toggle

# Define workspace names
set $ws1 "1:Main"
set $ws2 "2:Internet"
set $ws3 "3:Code"
set $ws4 "4:Doc"
set $ws5 "5:Work"
set $ws6 "6:Other"

# Switch to workspace
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6

# Move container to workspace and switch
bindsym $mod+Shift+1 move container to workspace $ws1; workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2; workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3; workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4; workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5; workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6; workspace $ws6

# Reload configuration
bindsym $mod+Ctrl+Shift+c reload

# Restart Sway
bindsym $mod+Ctrl+Shift+r restart

# Resize mode
mode "resize" {
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Up resize grow height 10 px or 10 ppt
    bindsym Down resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Shift+r mode "resize"

# Move workspace to current output
bindsym $mod+Shift+Control+1 [workspace=$ws1] move workspace to output current; workspace --no-auto-back-and-forth $ws1
bindsym $mod+Shift+Control+2 [workspace=$ws2] move workspace to output current; workspace --no-auto-back-and-forth $ws2
bindsym $mod+Shift+Control+3 [workspace=$ws3] move workspace to output current; workspace --no-auto-back-and-forth $ws3
bindsym $mod+Shift+Control+4 [workspace=$ws4] move workspace to output current; workspace --no-auto-back-and-forth $ws4
bindsym $mod+Shift+Control+5 [workspace=$ws5] move workspace to output current; workspace --no-auto-back-and-forth $ws5
bindsym $mod+Shift+Control+6 [workspace=$ws6] move workspace to output current; workspace --no-auto-back-and-forth $ws6

# Focus output
bindsym $mod+Control+Shift+Left focus output left
bindsym $mod+Control+Shift+Right focus output right

# Passthrough mode
mode "passthrough" {
    bindsym Escape mode "default"
}

bindsym $mod+Escape mode "passthrough"

# Better font rendering for various toolkits
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK

# Force Wayland backend for better rendering
exec_always {
    gsettings set org.gnome.desktop.interface font-antialiasing 'rgba'
    gsettings set org.gnome.desktop.interface font-hinting 'slight'
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
}

# Cursor theme (also applied to XWayland apps via xcursor_theme)
seat * xcursor_theme Bibata-Modern-Classic 24
