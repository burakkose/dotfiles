#! /usr/bin/env python3

import sys
import os
import csv
import subprocess

home = os.getenv("HOME")
sys.path.append(home + "/.lib/pybase")

from rofi import Rofi

import yaml


def get_path(path_str):
    return os.path.expanduser(path_str)


config_path = get_path("~/.config/rofi/bookmarks-config.yaml")

with open(config_path, "r") as stream:
    files = yaml.safe_load(stream) or []
    attr = []
    for file in files:
        with open(get_path(file), "r") as csv_file:
            reader = csv.reader(csv_file, delimiter=",")
            rows = list(reader)[1:]
            for row in rows:
                if len(row) != 2:
                    raise ValueError(f"Invalid bookmark row in {file}: {row}")
                attr.append(row)
    (options, values) = zip(*attr)
    r = Rofi()
    index = r.select("Select bookmark: ", options)[0]
    if index != -1:
        browser_args = [arg.strip() for arg in values[index].split("|") if arg.strip()]
        subprocess.run(["browser", *browser_args], check=False)
