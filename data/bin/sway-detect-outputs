#!/usr/bin/env bash
# sway-detect-outputs — discover the connected sway outputs, pick the
# highest-resolution / highest-refresh mode for each, and write a per-
# machine output configuration to ~/.config/sway/outputs.local.
#
# Replaces kanshi for the "set best mode on first provision" workflow.
# This script runs once on first `make dotfiles`. Subsequent runs
# refuse to overwrite the file unless invoked with --force, so any
# hand-edits the user makes (scale, position, disabling an output)
# survive future provisioning.
#
# Identifier: outputs are matched by EDID make/model/serial string,
# not connector name (DP-1, HDMI-A-1...). EDID survives GPU and cable
# changes; connector names do not.
#
# Output defaults: scale 1.0 (user dials in afterwards), subpixel rgb,
# scale_filter smart, transform normal, adaptive_sync off,
# max_render_time 2ms. All values consistent with the previous
# hand-tuned eDP-1 block.

set -euo pipefail

OUT_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/sway/outputs.local"
FORCE=0

for arg in "$@"; do
    case "$arg" in
        -f|--force) FORCE=1 ;;
        -h|--help)
            cat <<EOF
Usage: $0 [-f|--force]

Detect sway outputs and write ~/.config/sway/outputs.local.

  -f, --force   Regenerate even if outputs.local already exists
                (otherwise existing files are preserved untouched).
EOF
            exit 0
            ;;
    esac
done

if [ -e "$OUT_FILE" ] && [ "$FORCE" -eq 0 ]; then
    echo "$OUT_FILE already exists; skipping (use --force to regenerate)." >&2
    exit 0
fi

if ! command -v swaymsg >/dev/null 2>&1; then
    echo "swaymsg not installed; sway must be available to detect outputs." >&2
    exit 1
fi

if ! swaymsg -t get_version >/dev/null 2>&1; then
    echo "sway is not running; cannot detect outputs from this session." >&2
    exit 0
fi

mkdir -p "$(dirname "$OUT_FILE")"
TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

cat > "$TMP" <<'HEAD'
# =============================================================================
# Per-machine sway output configuration.
#
# Generated by ~/.bin/sway-detect-outputs on first provision.
# Safe to edit by hand — make dotfiles will NOT overwrite this file.
# Re-run with `~/.bin/sway-detect-outputs --force` to regenerate after
# monitor changes.
#
# Outputs are identified by EDID make/model/serial string so the config
# follows the physical monitor across cable / GPU / connector swaps.
# =============================================================================
HEAD

swaymsg -t get_outputs | jq -c '.[]' | while read -r out; do
    name=$(echo "$out" | jq -r '.name')
    make=$(echo "$out" | jq -r '.make // "Unknown"')
    model=$(echo "$out" | jq -r '.model // "Unknown"')
    serial=$(echo "$out" | jq -r '.serial // "Unknown"')
    identifier="${make} ${model} ${serial}"

    # Pick highest mode: tuple (width*height, refresh) descending.
    best=$(echo "$out" | jq -c '.modes | sort_by([.width * .height, .refresh]) | last')
    if [ "$best" = "null" ] || [ -z "$best" ]; then
        echo "Skipping ${name}: no modes reported" >&2
        continue
    fi

    bw=$(echo "$best" | jq -r '.width')
    bh=$(echo "$best" | jq -r '.height')
    br_mhz=$(echo "$best" | jq -r '.refresh')
    br=$(awk -v r="$br_mhz" 'BEGIN { printf "%.3f", r / 1000 }')

    cat >> "$TMP" <<BLOCK

# ${name}
output "${identifier}" {
    mode  ${bw}x${bh}@${br}Hz
    scale 1.0
    scale_filter smart
    subpixel rgb
    transform normal
    adaptive_sync off
    max_render_time 2
}
BLOCK
done

mv "$TMP" "$OUT_FILE"
echo "Wrote $OUT_FILE"

# Reload sway so the new outputs config takes effect immediately.
swaymsg reload >/dev/null 2>&1 || true
