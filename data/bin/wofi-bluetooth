#!/usr/bin/env python3

import os
import re
import shutil
import subprocess
import sys
import time


DEVICE_PATTERN = re.compile(
    r"^Device\s+(?P<address>(?:[0-9A-F]{2}:){5}[0-9A-F]{2})\s+(?P<name>.+)$",
    re.IGNORECASE,
)


def bluetoothctl(*args, timeout=35):
    try:
        return subprocess.run(
            ["bluetoothctl", *args],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        output = error.stdout or ""
        return subprocess.CompletedProcess(error.cmd, 124, output)


def notify(summary, message, urgency="normal"):
    notifier = shutil.which("notify-send")
    if notifier:
        subprocess.run(
            [notifier, "--urgency", urgency, summary, message],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )


def parse_devices(output):
    devices = {}
    for line in output.splitlines():
        match = DEVICE_PATTERN.match(line.strip())
        if match:
            devices[match.group("address").upper()] = match.group("name").strip()
    return devices


def devices(filter_name=None):
    args = ["devices"]
    if filter_name:
        args.append(filter_name)
    result = bluetoothctl(*args)
    return parse_devices(result.stdout) if result.returncode == 0 else {}


def controller_powered():
    result = bluetoothctl("show")
    if result.returncode != 0:
        return None
    match = re.search(r"^\s*Powered:\s*(yes|no)\s*$", result.stdout, re.MULTILINE)
    return match.group(1) == "yes" if match else None


def controller_discovering():
    result = bluetoothctl("show")
    if result.returncode != 0:
        return False
    match = re.search(r"^\s*Discovering:\s*(yes|no)\s*$", result.stdout, re.MULTILINE)
    return match.group(1) == "yes" if match else False


def menu_options():
    powered = controller_powered()
    options = {}

    if powered is None:
        options["Bluetooth controller unavailable"] = ("noop", None, None)
        return options

    power_label = "󰂲  Turn Bluetooth off" if powered else "󰂯  Turn Bluetooth on"
    options[power_label] = ("power", None, not powered)
    options["  Open bluetoothctl in terminal"] = ("terminal", None, None)

    if not powered:
        return options

    known = devices()
    paired = set(devices("Paired"))
    connected = set(devices("Connected"))

    name_counts = {}
    for name in known.values():
        name_counts[name.casefold()] = name_counts.get(name.casefold(), 0) + 1

    for address, name in sorted(
        known.items(),
        key=lambda item: (item[0] not in connected, item[1].casefold()),
    ):
        suffix = f"  {address}" if name_counts[name.casefold()] > 1 else ""
        if address in connected:
            label = f"󰂱  {name}  connected{suffix}"
            action = "disconnect"
        elif address in paired:
            label = f"󰂯  {name}{suffix}"
            action = "connect"
        else:
            label = f"＋  {name}  pair{suffix}"
            action = "pair"
        options[label] = (action, address, name)
    options["󰑐  Scan for devices"] = ("scan", None, None)
    if controller_discovering():
        options["󰅖  Stop scanning"] = ("scan-stop", None, None)
    else:
        options["󰑐  Scan for devices"] = ("scan-start", None, None)
    return options


def choose(options):
    launcher = os.path.expanduser("~/.bin/sway-nofullscreen-launcher")
    result = subprocess.run(
        [launcher, "wofi", "--dmenu", "--insensitive", "--prompt", "Bluetooth"],
        input="\n".join(options),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.rstrip("\n")


def require_success(result, action, name):
    if result.returncode == 0 and "failed" not in result.stdout.casefold():
        return True
    message = result.stdout.strip() or f"{action.capitalize()} failed"
    notify(f"Bluetooth {action} failed", f"{name}: {message}", "critical")
    return False


def connect(address, name, pair=False):
    if pair:
        result = bluetoothctl("--timeout", "30", "pair", address, timeout=35)
        if not require_success(result, "pairing", name):
            return

    trust_result = bluetoothctl("trust", address)
    if not require_success(trust_result, "trust", name):
        return

    result = bluetoothctl("--timeout", "20", "connect", address, timeout=25)
    if require_success(result, "connection", name):
        notify("Bluetooth connected", name)


def run_action(action):
    kind, address, value = action
    if kind == "noop":
        return
    if kind == "power":
        state = "on" if value else "off"
        result = bluetoothctl("power", state)
        if not require_success(result, "power", f"Bluetooth {state}"):
            return
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)])
    if kind == "scan-start":
        notify("Bluetooth scan", "Scanning for nearby devices")
        subprocess.Popen(
            ["bluetoothctl", "--timeout", "60", "scan", "on"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        time.sleep(0.5)
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)])
    if kind == "scan-stop":
        result = bluetoothctl("scan", "off")
        if not require_success(result, "scan", "Stop scanning"):
            return
        os.execv(sys.executable, [sys.executable, os.path.abspath(__file__)])
    if kind == "terminal":
        subprocess.Popen(
            ["foot", "bluetoothctl"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    if kind == "disconnect":
        result = bluetoothctl("disconnect", address)
        if require_success(result, "disconnection", value):
            notify("Bluetooth disconnected", value)
    if kind == "connect":
        connect(address, value)
    if kind == "pair":
        connect(address, value, pair=True)


def main():
    if not shutil.which("bluetoothctl"):
        notify("Bluetooth unavailable", "bluetoothctl is not installed", "critical")
        return

    options = menu_options()
    selected = choose(options)
    if selected in options:
        run_action(options[selected])


if __name__ == "__main__":
    main()
