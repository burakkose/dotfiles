#!/usr/bin/env python3

import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.expanduser("~/.lib/pybase"))

from wofi_helpers import choose, notify, run, succeeded


def prompt_password(ssid):
    launcher = os.path.expanduser("~/.bin/sway-nofullscreen-launcher")
    result = subprocess.run(
        [launcher, "wofi", "--dmenu", "--password", "--prompt", f"Password for {ssid}"],
        input="\n",
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.stdout.rstrip("\n")


def split_nmcli(line):
    fields = []
    current = []
    escaped = False
    for character in line:
        if escaped:
            current.append(character)
            escaped = False
        elif character == "\\":
            escaped = True
        elif character == ":":
            fields.append("".join(current))
            current = []
        else:
            current.append(character)
    fields.append("".join(current))
    return fields


def nmcli(*args, timeout=40):
    return run(["nmcli", "--terse", "--escape", "yes", *args], timeout=timeout)


def device_status():
    result = nmcli("-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status")
    devices = []
    if result.returncode != 0:
        return devices
    for line in result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) >= 4:
            devices.append(
                {
                    "device": fields[0],
                    "type": fields[1],
                    "state": fields[2],
                    "connection": fields[3],
                }
            )
    return devices


def bluetooth_status():
    if not shutil.which("bluetoothctl"):
        return "unavailable"

    connected = run(["bluetoothctl", "devices", "Connected"])
    names = []
    if connected.returncode == 0:
        for line in connected.stdout.splitlines():
            parts = line.split(maxsplit=2)
            if len(parts) == 3 and parts[0] == "Device":
                names.append(parts[2])
    if names:
        return ", ".join(names)

    controller = run(["bluetoothctl", "show"])
    return "on" if "Powered: yes" in controller.stdout else "off"


def vpn_connections():
    all_result = nmcli("-f", "NAME,UUID,TYPE", "connection", "show")
    active_result = nmcli("-f", "UUID,TYPE", "connection", "show", "--active")
    active = set()
    for line in active_result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) >= 2 and fields[1] in {"vpn", "wireguard"}:
            active.add(fields[0])

    connections = []
    for line in all_result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) >= 3 and fields[2] in {"vpn", "wireguard"}:
            connections.append(
                {
                    "name": fields[0],
                    "uuid": fields[1],
                    "active": fields[1] in active,
                }
            )
    return connections


def hub_options(include_bluetooth=False):
    statuses = device_status()
    wifi = next((item for item in statuses if item["type"] == "wifi"), None)
    ethernet = next(
        (item for item in statuses if item["type"] == "ethernet" and item["state"] == "connected"),
        None,
    )

    wifi_status = wifi["connection"] if wifi and wifi["state"] == "connected" else "disconnected"
    ethernet_status = ethernet["connection"] if ethernet else "disconnected"

    vpns = vpn_connections()
    active_vpns = [vpn["name"] for vpn in vpns if vpn["active"]]
    vpn_status = ", ".join(active_vpns) if active_vpns else "disconnected"

    options = {
        f"󰈀  Ethernet  ·  {ethernet_status}": ("ethernet", None),
        f"󰖩  Wi-Fi  ·  {wifi_status}": ("wifi", None),
    }
    if include_bluetooth:
        options[f"󰂯  Bluetooth  ·  {bluetooth_status()}"] = ("bluetooth", None)
    options[f"󰒄  VPN  ·  {vpn_status}"] = ("vpn", None)
    options["󰒓  NetworkManager settings"] = ("settings", None)
    return options


def ethernet_address(device):
    result = run(["nmcli", "--get-values", "IP4.ADDRESS", "device", "show", device])
    if result.returncode != 0:
        return ""
    return next((line.strip() for line in result.stdout.splitlines() if line.strip()), "")


def ethernet_menu():
    options = {}
    for device in device_status():
        if device["type"] != "ethernet":
            continue

        interface = device["device"]
        state = device["state"]
        connection = device["connection"]
        if state == "connected":
            address = ethernet_address(interface)
            details = "  ·  ".join(item for item in (connection, address) if item)
            label = f"󰈀  {interface}  ·  {details}"
            options[label] = ("disconnect", interface, connection)
        elif state == "unmanaged":
            options[f"󰈂  {interface}  ·  unmanaged"] = ("noop", interface, state)
        else:
            options[f"󰈂  {interface}  ·  {state}"] = ("connect", interface, connection)

    options["󰒓  NetworkManager settings"] = ("settings", None, None)
    selected = choose(options, "Ethernet")
    if selected not in options:
        return

    action, interface, description = options[selected]
    if action == "noop":
        return
    if action == "settings":
        open_settings()
        return
    if action == "disconnect":
        result = run(["nmcli", "device", "disconnect", interface])
        report_network_result(result, "Ethernet disconnected", description or interface)
    if action == "connect":
        result = run(["nmcli", "device", "connect", interface], timeout=50)
        report_network_result(result, "Ethernet connected", interface)


def wifi_networks():
    result = nmcli(
        "-f",
        "IN-USE,SSID,BSSID,SIGNAL,SECURITY",
        "device",
        "wifi",
        "list",
        "--rescan",
        "yes",
        timeout=50,
    )
    networks = []
    seen = set()
    if result.returncode != 0:
        return networks

    for line in result.stdout.splitlines():
        fields = split_nmcli(line)
        if len(fields) < 5:
            continue
        in_use, ssid, bssid, signal, security = fields[:5]
        if not ssid or not bssid or bssid in seen:
            continue
        seen.add(bssid)
        security = security.strip()
        networks.append(
            {
                "ssid": ssid,
                "bssid": bssid,
                "connected": in_use.strip() == "*",
                "signal": int(signal) if signal.isdigit() else 0,
                "security": security if security not in {"", "--"} else "",
            }
        )
    return networks


def wifi_menu():
    radio = run(["nmcli", "radio", "wifi"]).stdout.strip() == "enabled"
    options = {
        ("󰖪  Turn Wi-Fi off" if radio else "󰖩  Turn Wi-Fi on"): ("power", not radio)
    }

    if radio:
        networks = wifi_networks()
        name_counts = {}
        for network in networks:
            key = network["ssid"].casefold()
            name_counts[key] = name_counts.get(key, 0) + 1

        for network in networks:
            lock = "󰌾" if network["security"] else "󰿆"
            security = network["security"] or "open"
            duplicate = (
                f"  ·  {network['bssid']}"
                if name_counts[network["ssid"].casefold()] > 1
                else ""
            )
            if network["connected"]:
                label = (
                    f"󰖩  {network['ssid']}  ·  connected  ·  "
                    f"{security}  ·  {network['signal']}%{duplicate}"
                )
                action = ("disconnect", network["ssid"])
            else:
                label = (
                    f"{lock}  {network['ssid']}  ·  {security}  ·  "
                    f"{network['signal']}%{duplicate}"
                )
                action = ("connect", network)
            options[label] = action

        options["󰑐  Rescan Wi-Fi networks"] = ("refresh", None)

    selected = choose(options, "Wi-Fi")
    if selected not in options:
        return

    action, value = options[selected]
    if action == "power":
        state = "on" if value else "off"
        result = run(["nmcli", "radio", "wifi", state])
        if result.returncode != 0:
            notify("Wi-Fi error", result.stdout.strip(), "critical")
        reopen("wifi")
    if action == "refresh":
        reopen("wifi")
    if action == "disconnect":
        wifi = next((item for item in device_status() if item["type"] == "wifi"), None)
        if wifi:
            result = run(["nmcli", "device", "disconnect", wifi["device"]])
            report_network_result(result, "Wi-Fi disconnected", value)
    if action == "connect":
        connect_wifi(value)


def connect_wifi(network):
    ssid = network["ssid"]
    bssid = network["bssid"]
    result = run(["nmcli", "device", "wifi", "connect", bssid], timeout=50)
    if not succeeded(result) and network["security"]:
        password = prompt_password(ssid)
        if not password:
            return
        result = run(
            ["nmcli", "--ask", "device", "wifi", "connect", bssid],
            timeout=50,
            input_text=f"{password}\n",
        )
    report_network_result(result, "Wi-Fi connected", ssid)


def vpn_menu():
    connections = vpn_connections()
    options = {}
    name_counts = {}
    for connection in connections:
        key = connection["name"].casefold()
        name_counts[key] = name_counts.get(key, 0) + 1

    for connection in connections:
        name = connection["name"]
        uuid = connection["uuid"]
        suffix = f"  ·  {uuid[:8]}" if name_counts[name.casefold()] > 1 else ""
        label = (
            f"󰦝  {name}  ·  connected{suffix}"
            if connection["active"]
            else f"󰦜  {name}{suffix}"
        )
        options[label] = ("down" if connection["active"] else "up", uuid, name)

    if not options:
        options["No VPN connections configured"] = ("noop", None, None)

    selected = choose(options, "VPN")
    if selected not in options:
        return
    action, uuid, name = options[selected]
    if action == "noop":
        return
    result = run(["nmcli", "connection", action, "uuid", uuid], timeout=50)
    report_network_result(
        result,
        "VPN disconnected" if action == "down" else "VPN connected",
        name,
    )


def report_network_result(result, summary, name):
    if succeeded(result):
        notify(summary, name)
    else:
        notify("NetworkManager error", result.stdout.strip() or name, "critical")


def open_settings():
    subprocess.Popen(
        ["nm-connection-editor"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def open_bluetooth():
    subprocess.Popen(
        [os.path.expanduser("~/.bin/wofi-bluetooth")],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def reopen(section=None):
    arguments = [sys.executable, os.path.abspath(__file__)]
    if section:
        arguments.append(section)
    os.execv(sys.executable, arguments)


def main():
    if not shutil.which("nmcli"):
        notify("Connectivity unavailable", "nmcli is not installed", "critical")
        return

    if len(sys.argv) > 1 and sys.argv[1] == "wifi":
        wifi_menu()
        return
    if len(sys.argv) > 1 and sys.argv[1] == "ethernet":
        ethernet_menu()
        return
    if len(sys.argv) > 1 and sys.argv[1] == "vpn":
        vpn_menu()
        return

    include_bluetooth = "all" in sys.argv[1:]
    options = hub_options(include_bluetooth=include_bluetooth)
    selected = choose(options, "Connectivity" if include_bluetooth else "Network")
    if selected not in options:
        return
    action, _ = options[selected]
    if action == "ethernet":
        ethernet_menu()
    elif action == "wifi":
        wifi_menu()
    elif action == "bluetooth":
        open_bluetooth()
    elif action == "vpn":
        vpn_menu()
    elif action == "settings":
        open_settings()


if __name__ == "__main__":
    main()
